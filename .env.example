# ── Monday.com ──────────────────────────────────────────────────────────────
# Generate at: https://monday.com/apps/manage/tokens
MONDAY_API_KEY=your_monday_api_key_here

# ── Azure AD (app-only / client credentials) ─────────────────────────────────
# App registration in Azure portal → Certificates & secrets → New client secret
# Permissions needed: Sites.ReadWrite.All (Application, not Delegated)
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# ── SharePoint ───────────────────────────────────────────────────────────────
# Run POST /api/sharepoint with action=discover once to find these values
SHAREPOINT_SITE_ID=your_site_id_here
SHAREPOINT_LIST_ID=your_list_id_here
